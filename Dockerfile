# snugcode runner in a container (Fly.io, Railway, VPS, …): the same daemon as on a PC, without a PC.
#   docker build -t snugcode .
#   docker run -d --restart unless-stopped -v snugcode:/data -e SNUGCODE_RELAY=https://snugcode.dev \
#     -e SNUGCODE_MACHINE_TOKEN=<token> -e SNUGCODE_PAIR_PIN=<pin> snugcode
# The full command (token & PIN) is generated by the phone app: Add machine → Cloud runner → Your own server.
# Models (API key / ChatGPT login) and GitHub login are configured from the phone app (or env SNUGCODE_API_KEY). Platforms that start containers
# on demand (e.g. Fly.io): SNUGCODE_IDLE_EXIT=1 makes the container exit after
# SNUGCODE_IDLE_MINUTES (default 30) of inactivity.
# bubblewrap + socat: OS sandbox for agent commands under auto-approve. Needs user namespaces; containers without
# that permission still run (snugcode detects it and says so in the session).
FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates chromium procps curl openssh-client python3 bubblewrap socat \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp/src
COPY package.json npm-shrinkwrap.json ./
COPY daemon ./daemon
COPY shared ./shared
# Installed as a global package (not a symlink): `snugcode update` from the phone overwrites the same folder.
RUN npm pack --silent && npm i -g ./snugcode-*.tgz --include=optional --no-audit --no-fund --loglevel=error \
  && rm -rf /tmp/src && mkdir -p /data && chown node:node /data
USER node
WORKDIR /home/node
ENV SNUGCODE_HOME=/data NODE_ENV=production
VOLUME /data
ENTRYPOINT ["snugcode", "cloud"]
