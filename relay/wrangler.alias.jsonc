{
  // Alamat publik singkat: https://snugcode.dev
  // Deploy AFTER the relay worker (wrangler.jsonc) since it uses a service binding to it:
  //   npx wrangler deploy -c wrangler.alias.jsonc   (already part of `npm run deploy` at the root)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snugcode",
  "main": "src/alias.js",
  "compatibility_date": "2026-09-01",
  // Workers logs & metrics (Cloudflare dashboard → Observability): relay errors visible without wrangler tail.
  "observability": { "enabled": true },
  // Custom domain (the snugcode.dev zone in the same Cloudflare account): wrangler deploy creates the DNS record
  // & certificate. The deploy token needs zone permissions Workers Routes: Edit, DNS: Edit, Zone: Read.
  // snugcode.arfak.workers.dev stays active as a legacy host (LEGACY_HOSTS in wrangler.jsonc).
  "routes": [{ "pattern": "snugcode.dev", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./public"
  },
  "services": [
    { "binding": "RELAY", "service": "pocketcode-relay" }
  ]
}
