{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The old worker name is kept: renaming = a new worker & database (see the README).
  // The short public address is provided by the `snugcode` alias worker (wrangler.alias.jsonc).
  "name": "pocketcode-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Workers logs & metrics (Cloudflare dashboard → Observability): relay errors visible without wrangler tail.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "Hub" },
      { "name": "PENDING", "class_name": "Pending" }
    ]
  },
  // Per-IP rate limit for login & machine registration (relay/src/index.js: limited).
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub", "Pending"] }
  ],
  "vars": {
    // GitHub OAuth App client ID (may be public). Its secret is set with
    // `wrangler secret put GITHUB_CLIENT_SECRET`.
    "GITHUB_CLIENT_ID": "Ov23li0XcnRmm4PTofH2",
    "DEV_AUTH": "0",
    // Main address for the PWA & login. Legacy hosts still serve PCs and the API, but login redirects here
    // (a GitHub OAuth App callback allows only one host) and the PWA on a legacy host offers to move.
    "PUBLIC_URL": "https://snugcode.dev",
    "LEGACY_HOSTS": "snugcode.arfak.workers.dev,pocketcode-relay.arfak.workers.dev",
    // The repo users fork for Codespaces runners (contains snugcode's .devcontainer/).
    "RUNNER_REPO": "arfakaisar/snugcode"
  }
}
