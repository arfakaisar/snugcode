// snugcode runner in GitHub Codespaces: the same daemon as on a PC, controlled from a phone.
// The app creates this codespace automatically (Settings → Use the cloud) from a fork of this repo; the machine
// token & PIN come from Codespaces secrets (SNUGCODE_MACHINE_TOKEN, SNUGCODE_PAIR_PIN, SNUGCODE_RELAY).
// See daemon/runner.js and docs/analisis-pwa-tanpa-pc.md.
{
  "name": "snugcode runner",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "hostRequirements": { "cpus": 2 },
  // /workspaces survives the codespace being stopped & rebuilt: worktrees, session history, agent transcripts.
  "containerEnv": { "SNUGCODE_HOME": "/workspaces/.snugcode" },
  // onCreateCommand also runs during Codespaces prebuilds (optional, set in the fork's repo settings): Chromium,
  // bubblewrap & snugcode are already installed in the snapshot, so a new runner starts in about 1 minute.
  "onCreateCommand": "bash .devcontainer/install.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/README.md"] }
  }
}
