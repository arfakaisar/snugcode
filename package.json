{
  "name": "snugcode",
  "version": "0.4.0",
  "description": "Multi-model remote coding agent (Claude Agent SDK, Codex, Gemini CLI) on your PC or in the cloud, controlled from your phone.",
  "type": "module",
  "bin": {
    "snugcode": "daemon/cli.js",
    "snug": "daemon/cli.js"
  },
  "files": [
    "daemon",
    "shared"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node daemon/cli.js start",
    "setup": "node daemon/cli.js setup",
    "build:web": "node scripts/build-web.mjs",
    "test": "node --test test/unit.test.js test/providers.test.js test/hardening.test.js test/features.test.js",
    "test:e2e": "node test/e2e-agent.mjs",
    "test:e2e:cloud": "node test/e2e-cloud.mjs",
    "test:e2e:connections": "node test/e2e-connections.mjs",
    "test:e2e:gemini": "node test/e2e-gemini.mjs",
    "bench": "node scripts/bench.mjs",
    "test:ui": "node test/e2e-ui.mjs",
    "test:e2e:resume": "node test/e2e-resume.mjs",
    "test:e2e:lock": "node test/e2e-lock.mjs",
    "typecheck": "tsc -p .",
    "dev:relay": "node test/dev-relay.mjs",
    "docs:images": "node scripts/docs-images.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.304",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.2",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15"
  },
  "homepage": "https://snugcode.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arfakaisar/snugcode.git"
  }
}
