{
  "name": "snugcode",
  "version": "0.3.0",
  "description": "Remote coding agent (Claude Code harness + 9router) di PC-mu, dikendalikan dari HP.",
  "type": "module",
  "bin": {
    "snugcode": "daemon/cli.js",
    "snug": "daemon/cli.js"
  },
  "files": [
    "daemon",
    "shared"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node daemon/cli.js start",
    "setup": "node daemon/cli.js setup",
    "build:web": "node scripts/build-web.mjs",
    "test": "node --test test/unit.test.js test/providers.test.js test/hardening.test.js test/features.test.js",
    "test:e2e": "node test/e2e-agent.mjs",
    "test:e2e:cloud": "node test/e2e-cloud.mjs",
    "test:e2e:connections": "node test/e2e-connections.mjs",
    "test:e2e:gemini": "node test/e2e-gemini.mjs",
    "bench": "node scripts/bench.mjs",
    "test:ui": "node test/e2e-ui.mjs",
    "typecheck": "tsc -p . && npm --prefix relay run typecheck",
    "dev:relay": "npm run build:web && cd relay && npx wrangler dev --var DEV_AUTH:1",
    "deploy": "npm run build:web && cd relay && npx wrangler deploy && npx wrangler deploy -c wrangler.alias.jsonc",
    "docs:images": "node scripts/docs-images.mjs",
    "icons": "node scripts/icons.mjs",
    "test:e2e:relay": "node test/e2e-relay.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.304",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.2"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15"
  }
}
